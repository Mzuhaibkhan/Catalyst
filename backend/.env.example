PORT=3000
NODE_ENV=development
DATABASE_URL="file:./dev.db"

# Session limits
MAX_SESSIONS=100
SESSION_TTL_HOURS=2

# Curriculum path (optional override)
CURRICULUM_PATH=

# ─── Gemini (up to 3 keys) ───
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# ─── Groq (up to 2 keys) ───
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_1=
GROQ_API_KEY_2=

# ─── OpenAI (up to 2 keys) ───
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_KEY_1=
OPENAI_API_KEY_2=

# ─── xAI Grok (up to 2 keys) ───
GROK_API_KEY_1=
GROK_API_KEY_2=
GROK_MODEL=grok-3-mini

# ─── NVIDIA NIM (up to 2 keys) ───
NVIDIA_NIM_API_KEY_1=
NVIDIA_NIM_API_KEY_2=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct
